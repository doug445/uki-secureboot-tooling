#!/usr/bin/env bash
# Sign unsigned kernel extramodules (nvidia, etc.) with our MOK key.
# Called by pacman hook after nvidia package updates, or manually.
#
# Usage: sign-modules.sh [kernel-version]
#   kernel-version defaults to $(uname -r)

set -euo pipefail

# Same key pair as sign-all-dkms-modules and DKMS itself. Its certificate is
# the one signed-kernel-build embeds via /etc/kernel-signing/combined.pem.
MOK_KEY="/var/lib/dkms/mok.key"
MOK_CERT="/var/lib/dkms/mok.pub"
HASH="sha512"

KVER="${1:-$(uname -r)}"
SIGN_FILE="/usr/lib/modules/${KVER}/build/scripts/sign-file"
EXTRAMOD_DIR="/usr/lib/modules/${KVER}/extramodules"

if [[ ! -f "$SIGN_FILE" ]]; then
    echo "ERROR: sign-file not found for kernel ${KVER}" >&2
    exit 1
fi

if [[ ! -d "$EXTRAMOD_DIR" ]]; then
    echo "ERROR: extramodules dir not found: ${EXTRAMOD_DIR}" >&2
    exit 1
fi

if [[ ! -r "$MOK_KEY" || ! -r "$MOK_CERT" ]]; then
    echo "ERROR: signing key or certificate not readable: ${MOK_KEY} ${MOK_CERT}" >&2
    exit 1
fi

# Signer identity (issuer CN + serial) that modinfo reports for a module
# signed with MOK_CERT (DKMS writes it as DER). Empty if the certificate
# can't be read, in which case nothing is skipped and every module is signed.
cert_field() {
    openssl x509 -inform DER -in "$MOK_CERT" -noout "$@" 2>/dev/null \
        || openssl x509 -in "$MOK_CERT" -noout "$@" 2>/dev/null
}
MOK_SIGNER=$(cert_field -issuer -nameopt sep_multiline,lname,space_eq,utf8 | sed -n 's/^ *commonName = //p' || true)
MOK_SERIAL=$(cert_field -serial | sed -n 's/^serial=//p' | sed 's/../&:/g; s/:$//' || true)

signed=0
skipped=0

for mod_zst in "${EXTRAMOD_DIR}"/*.ko.zst; do
    [[ -f "$mod_zst" ]] || continue
    mod_name="$(basename "$mod_zst")"
    mod_ko="${mod_zst%.zst}"

    echo -n "  ${mod_name}: "

    # Decompress
    zstd -d -f -q "$mod_zst" -o "$mod_ko"

    # Check if already signed with our key
    if [[ -n "$MOK_SERIAL" \
          && "$(modinfo -F signer "$mod_ko" 2>/dev/null)" == "$MOK_SIGNER" \
          && "$(modinfo -F sig_key "$mod_ko" 2>/dev/null)" == "$MOK_SERIAL" ]]; then
        echo "already signed, skipping"
        rm -f "$mod_ko"
        skipped=$((skipped + 1))
        continue
    fi

    # Sign
    "$SIGN_FILE" "$HASH" "$MOK_KEY" "$MOK_CERT" "$mod_ko"

    # Recompress (replace original)
    zstd -f -q --rm "$mod_ko" -o "$mod_zst"

    echo "signed"
    signed=$((signed + 1))
done

echo "Done: ${signed} signed, ${skipped} skipped"
