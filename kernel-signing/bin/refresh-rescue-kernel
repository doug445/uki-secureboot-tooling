#!/usr/bin/env bash
# Snapshot a currently-installed signed UKI as a frozen rescue boot entry.
# The rescue UKI is never auto-regenerated by mkinitcpio or pacman hooks —
# it stays as the last known-good boot image until manually refreshed.
#
# Usage: sudo refresh-rescue-kernel [linuxNN]   (default: linux66, the LTS)
#
# Output: /boot/EFI/Linux/manjaro-RESCUE.efi — signed, auto-picked up by
# systemd-boot, visible as a dedicated entry labelled "Manjaro RESCUE".

set -euo pipefail

if [[ $EUID -ne 0 ]]; then
    echo "must run as root (writing to ESP + sbctl sign)" >&2; exit 1
fi

SRC_KERNEL="${1:-linux66}"

if [[ ! "$SRC_KERNEL" =~ ^linux([0-9])([0-9]+)$ ]]; then
    echo "invalid kernel name: $SRC_KERNEL" >&2
    echo "usage: $0 [linuxNN]  (e.g. linux66, linux612)" >&2
    exit 2
fi
MAJOR="${BASH_REMATCH[1]}"
MINOR="${BASH_REMATCH[2]}"
UKI_VER="${MAJOR}.${MINOR}"

SRC="/boot/EFI/Linux/manjaro-${UKI_VER}-x86_64.efi"
DST="/boot/EFI/Linux/manjaro-RESCUE.efi"

[[ -f $SRC ]] || { echo "source UKI missing: $SRC" >&2; exit 2; }

WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT

cp "$SRC" "$WORK/src.efi"
chmod 644 "$WORK/src.efi"

# strip existing PE authenticode signature — objcopy section-editing on a
# signed PE leaves a corrupt certificate table that sbctl can't parse.
sbattach --remove "$WORK/src.efi" 2>/dev/null || true

# patch .osrel so sd-boot labels this entry distinctly
objcopy --dump-section .osrel="$WORK/osrel.txt" "$WORK/src.efi"
sed -i 's|^PRETTY_NAME=.*|PRETTY_NAME="Manjaro RESCUE (frozen signed snapshot)"|' "$WORK/osrel.txt"
grep -q '^VARIANT=' "$WORK/osrel.txt" || echo 'VARIANT="Rescue snapshot"' >> "$WORK/osrel.txt"

objcopy --update-section .osrel="$WORK/osrel.txt" "$WORK/src.efi" "$WORK/rescue.efi"

# install to ESP (write to temp in /boot to avoid cross-fs copy issues)
cp "$WORK/rescue.efi" "$DST"
chmod 700 "$DST"

# sign with sbctl
sbctl sign -s "$DST" >/dev/null

# summary
SIZE=$(du -h "$DST" | awk '{print $1}')
TS=$(date -Iseconds)
echo "=== rescue kernel installed $TS ==="
echo "source  : $SRC (linux ${UKI_VER})"
echo "rescue  : $DST ($SIZE, signed)"
echo
echo "boot menu will show this entry as:"
echo "  \"Manjaro RESCUE (frozen signed snapshot)\""
echo
echo "the rescue is frozen — not touched by mkinitcpio, pacman hooks, or"
echo "signed-kernels-rebuild-all. Re-run this script after confirming a new"
echo "build is healthy to refresh the rescue snapshot."
