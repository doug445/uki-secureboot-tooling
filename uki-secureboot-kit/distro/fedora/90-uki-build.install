#!/usr/bin/env bash
# /etc/kernel/install.d/90-uki-build.install
# kernel-install plugin — builds and signs a UKI for every installed kernel.
# kernel-install(8) (run by dnf) calls plugins as
#   add KVER ENTRY-DIR KERNEL-IMAGE [INITRD...]    remove KVER ENTRY-DIR
# ENTRY-DIR ($BOOT/ENTRY-TOKEN/KVER/) is a directory, unused here and possibly
# absent. By hand (README smoke test): add KVER KERNEL-IMAGE  /  remove KVER
# Skips layout=uki and kernel images that are already UKIs (see README).
set -euo pipefail

COMMAND="${1:-}"
KVER="${2:-}"
# A regular file in $3 means the by-hand form; otherwise $3 is ENTRY-DIR.
if [[ -f "${3:-}" ]]; then
    KIMG="$3"
else
    KIMG="${4:-}"
fi

[[ -n "$COMMAND" && -n "$KVER" ]] || exit 0

# Where to drop the UKI: prefer XBOOTLDR if present, else ESP root.
if findmnt /boot >/dev/null 2>&1 && [[ "$(findmnt -no FSTYPE /boot)" == "vfat" ]]; then
    OUTDIR=/boot/EFI/Linux
elif findmnt /efi >/dev/null 2>&1; then
    OUTDIR=/efi/EFI/Linux
elif findmnt /boot/efi >/dev/null 2>&1; then
    OUTDIR=/boot/efi/EFI/Linux
else
    echo "90-uki-build: no ESP mounted — skipping UKI build" >&2
    exit 0
fi
mkdir -p "$OUTDIR"

UKI="$OUTDIR/fedora-${KVER}.efi"
INITRD="/boot/initramfs-${KVER}.img"
CMDLINE=/etc/kernel/cmdline

case "$COMMAND" in
    add)
        [[ -f "$KIMG" ]] || { echo "90-uki-build: no kernel image in arguments: $*" >&2; exit 1; }
        # kernel-install(8): with layout=uki, kernel-install builds the UKI itself
        # (uki_generator=) and 90-uki-copy.install installs it, so a UKI built here
        # would only duplicate that entry.
        if [[ "${KERNEL_INSTALL_LAYOUT:-}" == uki ]]; then
            echo "90-uki-build: layout=uki — kernel-install installs the UKI itself; skipping" >&2
            exit 0
        fi
        # An image that is already a UKI (or a UKI add-on) must not be wrapped in
        # another UKI. kernel-install >= 254 passes its type in
        # KERNEL_INSTALL_IMAGE_TYPE; called by hand, ask bootctl.
        ktype="${KERNEL_INSTALL_IMAGE_TYPE:-$(bootctl kernel-identify "$KIMG" 2>/dev/null || true)}"
        case "$ktype" in
            uki|addon)
                echo "90-uki-build: $KIMG is not a plain kernel (type: $ktype); not wrapping it in a UKI — install it with layout=uki" >&2
                exit 0 ;;
        esac
        [[ -f "$INITRD" ]] || exit 0   # dracut hook (90-dracut-install) runs before us
        [[ -s "$CMDLINE" ]] || { echo "90-uki-build: $CMDLINE missing" >&2; exit 0; }
        ukify build \
            --linux "$KIMG" \
            --initrd "$INITRD" \
            --cmdline "@${CMDLINE}" \
            --uname "$KVER" \
            --output "$UKI"
        if command -v sbctl >/dev/null; then
            sbctl sign -s "$UKI" || true
        fi
        ;;
    remove)
        if [[ -f "$UKI" ]]; then
            if command -v sbctl >/dev/null; then
                sbctl remove-file "$UKI" >/dev/null 2>&1 || true
            fi
            rm -f "$UKI"
        fi
        ;;
esac
