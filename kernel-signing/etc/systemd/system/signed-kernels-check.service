[Unit]
Description=Check upstream Manjaro kernels against locally-built signed kernels
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/signed-kernels-check
User=will
Environment=DISPLAY=:0
Environment=XDG_RUNTIME_DIR=/run/user/1000
SuccessExitStatus=0 10
